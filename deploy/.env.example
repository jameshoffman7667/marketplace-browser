# Variables for deploy/compose.yaml (names only; real values live in the server's stack .env).

# Host port = container port. Assigned from the port register (currently 3501; register plan: 8045).
PORT_HOST=3501

# Password for the web UI (required).
APP_PASSWORD=change-me

# Optional: fixed token for the browser extension. Leave empty to have one generated.
INGEST_TOKEN=

MIN_POLL_MINUTES=5

# Optional: override the data root (databases live in <FAST_STORAGE>/marketplace-browser).
# FAST_STORAGE=/srv/dev-disk-by-uuid-758425e9-f9ca-4fbc-ad81-eaea80fdfb73/appdata-ssd
