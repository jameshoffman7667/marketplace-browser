# Variables for stack/compose.yml. In Dockhand, add these as the stack's environment variables.

# Docker Hub image built by the GitHub Action. Pin a version for repeatable deploys.
TRACKER_IMAGE=yourdockerhubuser/classifieds-tracker:0.3.0

# Password for the web UI (required).
APP_PASSWORD=change-me

# Optional: fixed token for the browser extension. Leave empty to have one generated.
INGEST_TOKEN=

TRACKER_PORT=3501
TZ=America/Toronto
MIN_POLL_MINUTES=5
